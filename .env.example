PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/participant_journey
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@selcofoundation.org
ADMIN_PASSWORD=change-this-password
ADMIN_MOBILE=9876543210

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

FRONTEND_URL=http://localhost:5173

TWOFACTOR_API_KEY=
TWOFACTOR_OTP_VALIDITY=600

# ==========================================
# WhatsApp / Gupshup
# ==========================================
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=gupshup

# Gupshup Dashboard -> API Keys / App details
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
# Gupshup template UUID/ID used by the API (not the display name)
GUPSHUP_WELCOME_TEMPLATE_ID=7b02ea3e-7783-4442-8f9e-8fbe16dbdb59
GUPSHUP_POST_EVENT_TEMPLATE_ID=
GUPSHUP_API_BASE_URL=https://api.gupshup.io
# Optional secret used to reject unexpected webhook calls. Configure the same value in Gupshup if your app supports it.
GUPSHUP_WEBHOOK_SECRET=

# Approved WhatsApp template. The same template name can have language translations in Gupshup; send the correct language code.
WHATSAPP_WELCOME_TEMPLATE_NAME=
WHATSAPP_WELCOME_TEMPLATE_LANGUAGE=mr
# Optional separate approved template names by language if your account uses separate templates.
# Example: {"mr":"nandurbar_event_welcome","hi":"nandurbar_event_welcome","en":"nandurbar_event_welcome","gu":"nandurbar_event_welcome"}
WHATSAPP_WELCOME_TEMPLATE_NAMES={}
WHATSAPP_WELCOME_TEMPLATE_VARIABLES=name,event

# Post-event approved template(s), used after the event.
WHATSAPP_POST_EVENT_TEMPLATE_NAME=
WHATSAPP_POST_EVENT_TEMPLATE_LANGUAGE=mr
WHATSAPP_POST_EVENT_TEMPLATE_VARIABLES=name,event
WHATSAPP_POST_EVENT_TEMPLATE_NAMES={}
WHATSAPP_EVENT_NAME=Nandurbar Event

# Legacy TryowBot variables kept only for rollback/migration.
WHATSAPP_APP_ID=
WHATSAPP_API_KEY=
WHATSAPP_API_NAME=
WHATSAPP_API_URL=https://web.tryowbot.com/api/v1/send
WHATSAPP_RECEIVE_API_URL=https://web.tryowbot.com/api/v1/receive
WHATSAPP_RECEIVE_METHOD=GET
WHATSAPP_RECEIVE_ENABLED=false
WHATSAPP_POLL_INTERVAL_MS=30000
WHATSAPP_RECEIVE_LIMIT=25
WHATSAPP_RECEIVE_LOOKBACK_DAYS=1
WHATSAPP_RECEIVE_MOBILE=
WHATSAPP_RECEIVE_ALL_PARTICIPANTS=false
WHATSAPP_RECEIVE_BATCH_SIZE=50

# Meta compatibility fields (not used by Gupshup provider).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

# ==========================================
# Registration language / Google Translation
# ==========================================
GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_API_KEY=

DEFAULT_LANGUAGE=mr

# Supported registration languages: en, hi, mr, gu
# Questions remain backend-driven and are translated at request time when enabled.
